<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:id="@+id/tvQueuePatientName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_primary"
            android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvQueueConcern" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnMedication" android:layout_width="0dp"
                android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                android:backgroundTint="@color/green_light" android:text="Medication"
                android:textColor="@color/green_text" android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button" app:cornerRadius="8dp"/>
            <Button android:id="@+id/btnSchedule" android:layout_width="0dp"
                android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                android:backgroundTint="#FADBD8" android:text="Schedule"
                android:textColor="@color/red_logout_text" android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button" app:cornerRadius="8dp"/>
            <Button android:id="@+id/btnMarkDone" android:layout_width="0dp"
                android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp"
                android:backgroundTint="@color/green_primary" android:text="Done"
                android:textColor="@color/white" android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button" app:cornerRadius="8dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>